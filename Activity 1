def run_rr_without_overhead(processes, time_quantum):
    # processes: list of dicts with 'pid', 'arrival', 'burst'
    n = len(processes)
    queue = []
    time = 0
    completed = 0

    # Sort processes by arrival time initially
    procs = sorted([p.copy() for p in processes], key=lambda x: x['arrival'])
    for p in procs:
        p['remaining'] = p['burst']
        p['completion'] = 0
        p['turnaround'] = 0
        p['waiting'] = 0
        p['response'] = -1

    ready_queue = []
    gantt_chart = []

    # Add processes that arrive at time 0
    idx = 0
    while idx < n and procs[idx]['arrival'] <= time:
        ready_queue.append(procs[idx])
        idx += 1

    while completed < n:
        if not ready_queue:
            # CPU is idle, jump to next arrival
            time = procs[idx]['arrival']
            while idx < n and procs[idx]['arrival'] <= time:
                ready_queue.append(procs[idx])
                idx += 1
            continue

        curr = ready_queue.pop(0)

        if curr['response'] == -1:
            curr['response'] = time - curr['arrival']

        exec_time = min(time_quantum, curr['remaining'])
        gantt_chart.append((curr['pid'], time, time + exec_time))

        time += exec_time
        curr['remaining'] -= exec_time

        # Check newly arrived processes during execution
        while idx < n and procs[idx]['arrival'] <= time:
            # Avoid duplicate additions if already in ready_queue or completed
            if procs[idx] not in ready_queue and procs[idx]['remaining'] > 0:
                ready_queue.append(procs[idx])
            idx += 1

        if curr['remaining'] > 0:
            ready_queue.append(curr)
        else:
            curr['completion'] = time
            curr['turnaround'] = curr['completion'] - curr['arrival']
            curr['waiting'] = curr['turnaround'] - curr['burst']
            completed += 1

    total_context_switches = len(gantt_chart) - 1
    avg_tat = sum(p['turnaround'] for p in procs) / n
    avg_wt = sum(p['waiting'] for p in procs) / n

    return procs, gantt_chart, avg_tat, avg_wt, total_context_switches

# Dataset for Activity 1
activity1_data = [
    {'pid': 'P1', 'arrival': 0, 'burst': 5},
