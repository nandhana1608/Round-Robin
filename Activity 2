def run_rr_with_overhead(processes, time_quantum, overhead):
    n = len(processes)
    procs = sorted([p.copy() for p in processes], key=lambda x: x['arrival'])
    for p in procs:
        p['remaining'] = p['burst']
        p['completion'] = 0
        p['turnaround'] = 0
        p['waiting'] = 0
        p['response'] = -1

    ready_queue = []
    gantt_chart = []

    time = 0
    idx = 0
    while idx < n and procs[idx]['arrival'] <= time:
        ready_queue.append(procs[idx])
        idx += 1

    last_pid = None
    context_switches = 0
    total_overhead = 0

    while any(p['remaining'] > 0 for p in procs):
        if not ready_queue:
            time = procs[idx]['arrival']
            while idx < n and procs[idx]['arrival'] <= time:
                ready_queue.append(procs[idx])
                idx += 1
            last_pid = None
            continue

        curr = ready_queue.pop(0)

        # Apply context switching overhead if switching to a different process
        if last_pid is not None and last_pid != curr['pid']:
            gantt_chart.append(('CS', time, time + overhead))
            time += overhead
            total_overhead += overhead
            context_switches += 1

        if curr['response'] == -1:
            curr['response'] = time - curr['arrival']

        exec_time = min(time_quantum, curr['remaining'])
        gantt_chart.append((curr['pid'], time, time + exec_time))

        time += exec_time
        curr['remaining'] -= exec_time
        last_pid = curr['pid']

        while idx < n and procs[idx]['arrival'] <= time:
            if procs[idx] not in ready_queue and procs[idx]['remaining'] > 0:
                ready_queue.append(procs[idx])
            idx += 1

        if curr['remaining'] > 0:
            ready_queue.append(curr)
        else:
            curr['completion'] = time
            curr['turnaround'] = curr['completion'] - curr['arrival']
            curr['waiting'] = curr['turnaround'] - curr['burst']

    total_time = time
    cpu_efficiency = ((total_time - total_overhead) / total_time) * 100 if total_time > 0 else 0
    avg_tat = sum(p['turnaround'] for p in procs) / n
    avg_wt = sum(p['waiting'] for p in procs) / n

    return procs, gantt_chart, avg_tat, avg_wt, context_switches, total_overhead, cpu_efficiency, total_time

